generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OPERATIONS
  SUPPORT_ENGINEER
  ADMIN
}

enum OrderStatus {
  RECEIVED
  VALIDATING
  INVENTORY_ALLOCATED
  READY_FOR_PICKING
  DISPATCHED
  DELIVERED
  VALIDATION_FAILED
  INVENTORY_UNAVAILABLE
  INTEGRATION_FAILED
  MANUAL_REVIEW
  CANCELLED
}

enum AllocationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum ShipmentStatus {
  CREATED
  DISPATCHED
  DELIVERED
  FAILED
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ProcessedEventStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum AttemptClassification {
  SUCCESS
  RETRYABLE
  NON_RETRYABLE
  POISON
}

enum AttemptOutcome {
  SUCCEEDED
  FAILED
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum ReplayStatus {
  REQUESTED
  PUBLISHED
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(320)
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name") @db.VarChar(120)
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  incidentNotes IncidentNote[]
  replayRequests ReplayRequest[]
  auditLogs AuditLog[]

  @@map("users")
}

model Order {
  id                      String      @id @default(uuid()) @db.Uuid
  customerId              String      @map("customer_id") @db.VarChar(100)
  customerReference       String      @map("customer_reference") @db.VarChar(120)
  status                  OrderStatus @default(RECEIVED)
  failureCode             String?     @map("failure_code") @db.VarChar(100)
  failureMessageSanitized String?     @map("failure_message_sanitized") @db.VarChar(500)
  correlationId           String      @unique @map("correlation_id") @db.Uuid
  trackingNumber          String?     @unique @map("tracking_number") @db.VarChar(100)
  version                 Int         @default(1)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  items                   OrderItem[]
  allocations             InventoryAllocation[]
  shipment                Shipment?
  timeline                TimelineEntry[]
  attempts                ProcessingAttempt[]
  replayRequests          ReplayRequest[]

  @@index([status, createdAt(sort: Desc)])
  @@index([customerId])
  @@index([customerReference])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  sku         String   @db.VarChar(64)
  quantity    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  allocation  InventoryAllocation?

  @@unique([orderId, sku])
  @@index([sku])
  @@map("order_items")
}

model Inventory {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique @db.VarChar(64)
  onHand      Int      @map("on_hand")
  allocated   Int      @default(0)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  allocations InventoryAllocation[]

  @@map("inventory")
}

model InventoryAllocation {
  id          String           @id @default(uuid()) @db.Uuid
  orderId     String           @map("order_id") @db.Uuid
  orderItemId String           @unique @map("order_item_id") @db.Uuid
  inventoryId String           @map("inventory_id") @db.Uuid
  quantity    Int
  status      AllocationStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  inventory   Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([inventoryId, status])
  @@map("inventory_allocations")
}

model Shipment {
  id                        String         @id @default(uuid()) @db.Uuid
  orderId                   String         @unique @map("order_id") @db.Uuid
  carrier                   String         @db.VarChar(80)
  carrierRequestKey         String         @unique @map("carrier_request_key") @db.VarChar(160)
  trackingNumber            String         @unique @map("tracking_number") @db.VarChar(100)
  status                    ShipmentStatus @default(CREATED)
  responseMetadataSanitized Json?          @map("response_metadata_sanitized")
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  order                     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("shipments")
}

model IdempotencyKey {
  id             String           @id @default(uuid()) @db.Uuid
  scope          String           @db.VarChar(100)
  actorId        String           @map("actor_id") @db.Uuid
  key            String           @db.VarChar(160)
  requestHash    String           @map("request_hash") @db.Char(64)
  state          IdempotencyState @default(IN_PROGRESS)
  responseStatus Int?             @map("response_status")
  responseBody   Json?            @map("response_body")
  resourceId     String?          @map("resource_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([scope, actorId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  aggregateType  String    @map("aggregate_type") @db.VarChar(80)
  aggregateId    String    @map("aggregate_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(120)
  schemaVersion  Int       @map("schema_version")
  correlationId  String    @map("correlation_id") @db.Uuid
  causationId    String?   @map("causation_id") @db.Uuid
  payload        Json
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  attemptCount   Int       @default(0) @map("attempt_count")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastErrorCode  String?   @map("last_error_code") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([publishedAt, nextAttemptAt])
  @@index([aggregateId])
  @@map("outbox_events")
}

model ProcessedEvent {
  id              String               @id @default(uuid()) @db.Uuid
  consumer        String               @db.VarChar(100)
  eventId         String               @map("event_id") @db.Uuid
  status          ProcessedEventStatus @default(PROCESSING)
  attemptCount    Int                  @default(1) @map("attempt_count")
  leaseExpiresAt  DateTime             @map("lease_expires_at") @db.Timestamptz(3)
  processedAt     DateTime?            @map("processed_at") @db.Timestamptz(3)
  resultReference String?              @map("result_reference") @db.VarChar(160)
  lastErrorCode   String?              @map("last_error_code") @db.VarChar(100)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([consumer, eventId])
  @@index([status, leaseExpiresAt])
  @@map("processed_events")
}

model ProcessingAttempt {
  id                        String                @id @default(uuid()) @db.Uuid
  eventId                   String                @map("event_id") @db.Uuid
  orderId                   String?               @map("order_id") @db.Uuid
  sqsMessageId              String                @map("sqs_message_id") @db.VarChar(160)
  receiveCount              Int                   @map("receive_count")
  classification            AttemptClassification
  outcome                   AttemptOutcome
  safeErrorCode             String?               @map("safe_error_code") @db.VarChar(100)
  requestMetadataSanitized  Json?                 @map("request_metadata_sanitized")
  responseMetadataSanitized Json?                 @map("response_metadata_sanitized")
  startedAt                 DateTime               @map("started_at") @db.Timestamptz(3)
  finishedAt                DateTime               @map("finished_at") @db.Timestamptz(3)
  correlationId             String                @map("correlation_id") @db.Uuid
  order                     Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([correlationId])
  @@index([eventId])
  @@map("processing_attempts")
}

model TimelineEntry {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  correlationId String   @map("correlation_id") @db.Uuid
  type          String   @db.VarChar(100)
  source        String   @db.VarChar(80)
  summary       String   @db.VarChar(500)
  metadata      Json?
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, occurredAt])
  @@index([correlationId, occurredAt])
  @@map("timeline_entries")
}

model Incident {
  id                String           @id @default(uuid()) @db.Uuid
  title             String           @db.VarChar(200)
  severity          IncidentSeverity
  affectedService   String           @map("affected_service") @db.VarChar(120)
  status            IncidentStatus   @default(OPEN)
  detectedAt        DateTime         @map("detected_at") @db.Timestamptz(3)
  acknowledgedAt    DateTime?        @map("acknowledged_at") @db.Timestamptz(3)
  resolvedAt        DateTime?        @map("resolved_at") @db.Timestamptz(3)
  assignedTo        String?          @map("assigned_to") @db.Uuid
  businessImpact    String?          @map("business_impact") @db.Text
  rootCause         String?          @map("root_cause") @db.Text
  resolution        String?          @db.Text
  correctiveActions String?          @map("corrective_actions") @db.Text
  preventiveActions String?          @map("preventive_actions") @db.Text
  correlationIds    String[]         @map("correlation_ids") @db.Uuid
  failureEpisodeKey String?          @unique @map("failure_episode_key") @db.VarChar(200)
  version           Int              @default(1)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  notes             IncidentNote[]

  @@index([status, severity, detectedAt(sort: Desc)])
  @@index([assignedTo])
  @@map("incidents")
}

model IncidentNote {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt])
  @@map("incident_notes")
}

model ReplayRequest {
  id             String       @id @default(uuid()) @db.Uuid
  originalEventId String      @map("original_event_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  requestedBy    String       @map("requested_by") @db.Uuid
  reason         String       @db.VarChar(500)
  status         ReplayStatus @default(REQUESTED)
  newEventId     String?      @map("new_event_id") @db.Uuid
  idempotencyKey String       @unique @map("idempotency_key") @db.VarChar(160)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requester      User         @relation(fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@map("replay_requests")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String   @map("actor_id") @db.Uuid
  action        String   @db.VarChar(120)
  entityType    String   @map("entity_type") @db.VarChar(80)
  entityId      String   @map("entity_id") @db.Uuid
  correlationId String   @map("correlation_id") @db.Uuid
  reason        String?  @db.VarChar(500)
  beforeMetadata Json?   @map("before_metadata")
  afterMetadata  Json?   @map("after_metadata")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor         User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([correlationId, createdAt])
  @@map("audit_logs")
}
