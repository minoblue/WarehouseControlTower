NODE_ENV=development
APP_VERSION=0.1.0
GIT_SHA=local

POSTGRES_DB=warehouse
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql://app:app@postgres:5432/warehouse?schema=public

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENT_BUS_NAME=warehouse-events
ORDER_QUEUE_NAME=order-processing
ORDER_DLQ_NAME=order-processing-dlq
ORDER_QUEUE_URL=http://localstack:4566/000000000000/order-processing
ORDER_DLQ_URL=http://localstack:4566/000000000000/order-processing-dlq

API_PORT=3000
WORKER_PORT=3001
MOCK_CARRIER_PORT=3002
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000

CARRIER_BASE_URL=http://mock-carrier:3002
CARRIER_TIMEOUT_MS=3000
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_RECEIVE_COUNT=3
WORKER_CONCURRENCY=4
OUTBOX_POLL_INTERVAL_MS=1000

JWT_ISSUER=warehouse-control-tower
JWT_AUDIENCE=warehouse-control-tower-web
JWT_ACCESS_TTL_SECONDS=900
JWT_SECRET=local-development-secret-change-before-use-32-chars
DEMO_ADMIN_PASSWORD=LocalAdmin123!
DEMO_SUPPORT_PASSWORD=LocalSupport123!
DEMO_OPERATIONS_PASSWORD=LocalOperations123!
MOCK_CARRIER_ADMIN_KEY=local-mock-carrier-control-key

LOG_LEVEL=info
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
